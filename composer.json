{
    "name": "selveq/wishlist-graphql",
    "description": "Magento 2 Wishlist GraphQl extension for ScandiPWA theme",
    "type": "magento2-module",
    "version": "3.0.0",
    "license": [
        "OSL-3.0"
    ],
    "authors": [
        {
            "name": "Scandiweb",
            "homepage": "https://scandiweb.com",
            "role": "Original author"
        },
        {
            "name": "Selveq",
            "homepage": "https://selveq.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/selveq/wishlist-graphql/issues",
        "source": "https://github.com/selveq/wishlist-graphql"
    },
    "require": {
        "php": "^8.3",
        "magento/framework": "^103.0",
        "magento/module-bundle": "^101.0",
        "magento/module-catalog": "^104.0",
        "magento/module-catalog-graph-ql": "^100.4",
        "magento/module-catalog-inventory": "^100.4",
        "magento/module-configurable-product": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-downloadable": "^100.4",
        "magento/module-grouped-product": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-store": "^101.1",
        "magento/module-wishlist": "^101.2",
        "magento/module-wishlist-graph-ql": "^100.4",
        "laminas/laminas-validator": "^2.65",
        "selveq/performance": "^2.0"
    },
    "replace": {
        "scandipwa/wishlist-graphql": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "ScandiPWA\\WishlistGraphQl\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.gitignore"
        ]
    }
}
